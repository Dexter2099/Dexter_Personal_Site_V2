{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"dexter-portfolio-chat-local",
  "pages_build_output_dir":"dist",
  "compatibility_date":"2026-10-12",
  "d1_databases":[{"binding":"CHAT_DB","database_name":"portfolio-chat-local","database_id":"00000000-0000-0000-0000-000000000001","migrations_dir":"migrations"}],
  "vars": {
    "CHAT_ENABLED":"false", "CHAT_PROVIDER":"preview", "CHAT_LOCAL_ONLY":"true",
    "CHAT_DEVELOPMENT_MODE":"true", "CHAT_MONTHLY_USD":"5", "CHAT_DAILY_USD":"0"
  }
}
