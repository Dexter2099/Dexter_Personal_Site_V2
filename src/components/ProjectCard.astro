---
import type { Project } from "../data/projects";

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const titleId = `${project.title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}-title`;
---

<article class="project-card" aria-labelledby={titleId}>
  <div class="project-card__media">
    <video
      class:list={{ "project-card__video--contain": project.videoFit === "contain" }}
      src={project.videoSrc}
      aria-label={project.videoLabel}
      title={project.videoLabel}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    >
      Your browser cannot load this demo video. <a href={project.videoSrc}>Open the {project.title} demo video directly.</a>
    </video>
  </div>
  <div class="project-card__content">
    <h2 id={titleId}>{project.title}</h2>
    <p class="project-card__description">{project.description}</p>
    <p class="project-card__emphasis">{project.emphasis}</p>
    <ul class="project-card__tech" aria-label={`${project.title} technology stack`}>
      {
        project.techStack.map((tech) => (
          <li>{tech}</li>
        ))
      }
    </ul>
    {
      project.githubUrl && (
        <div class="project-card__actions">
          <a
            class="project-card__github"
            href={project.githubUrl}
            aria-label={`View ${project.title} on GitHub`}
            target="_blank"
            rel="noreferrer"
          >
            <svg class="project-card__github-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 1.75C6.34 1.75 1.75 6.42 1.75 12.18c0 4.61 2.93 8.52 7.01 9.9.51.1.69-.23.69-.5 0-.25-.01-1.08-.01-1.95-2.85.63-3.45-1.22-3.45-1.22-.47-1.22-1.14-1.54-1.14-1.54-.93-.65.07-.64.07-.64 1.03.07 1.58 1.08 1.58 1.08.91 1.59 2.4 1.13 2.98.86.09-.68.36-1.13.65-1.39-2.28-.27-4.67-1.17-4.67-5.19 0-1.15.4-2.09 1.06-2.83-.11-.27-.46-1.35.1-2.82 0 0 .87-.28 2.85 1.08.83-.24 1.71-.36 2.59-.37.88 0 1.77.13 2.6.37 1.97-1.36 2.84-1.08 2.84-1.08.56 1.47.21 2.55.1 2.82.66.74 1.06 1.68 1.06 2.83 0 4.03-2.39 4.91-4.68 5.18.37.33.7.97.7 1.95 0 1.41-.01 2.55-.01 2.9 0 .28.18.61.7.5 4.07-1.39 6.99-5.29 6.99-9.9C22.25 6.42 17.66 1.75 12 1.75Z" />
            </svg>
            <span class="project-card__sr-only">View {project.title} on GitHub</span>
          </a>
        </div>
      )
    }
  </div>
</article>
