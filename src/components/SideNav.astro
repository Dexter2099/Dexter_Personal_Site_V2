---
import { navItems } from "../data/nav";
import type { NavItem } from "../data/nav";

const currentPath = Astro.url.pathname;

const isCurrent = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath.startsWith(href);
};

const iconPaths: Record<NavItem["icon"], string[]> = {
  home: ["M3 10.5 12 3l9 7.5", "M5 9.5V21h5v-6h4v6h5V9.5"],
  briefcase: ["M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2", "M4 7h16v13H4z", "M4 12h16"],
  folder: ["M3 6h7l2 2h9v13H3z", "M3 10h18"],
  user: ["M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z", "M4.5 21a7.5 7.5 0 0 1 15 0"],
  mail: ["M4 6h16v14H4z", "m4 7 8 7 8-7"]
};
---

<nav class="site-nav" aria-label="Primary navigation">
  <ul class="site-nav__list">
    {
      navItems.map((item) => (
        <li class="site-nav__item">
          <a
            class:list={["site-nav__link", { "site-nav__link--active": isCurrent(item.href) }]}
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            aria-label={item.label}
          >
            <span class="site-nav__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                {iconPaths[item.icon].map((path) => <path d={path} />)}
              </svg>
            </span>
            <span class="site-nav__label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
