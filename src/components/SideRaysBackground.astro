---
import SideRays from "./react/SideRays.jsx";
---

<div class="side-rays-background" aria-hidden="true">
  <SideRays
    client:idle
    speed={2.5}
    rayColor1="#F5EBC8"
    rayColor2="#EAB308"
    intensity={1.35}
    spread={1.25}
    origin="top-right"
    tilt={0}
    saturation={1.5}
    blend={0.75}
    falloff={1.6}
    opacity={0.62}
  />
</div>
