---
const placeholderSongs = [
  { title: "Placeholder Song", artist: "Placeholder Artist" },
  { title: "Placeholder Song", artist: "Placeholder Artist" },
  { title: "Placeholder Song", artist: "Placeholder Artist" }
];

// TODO: Add real Spotify integration later without API keys or OAuth in this static foundation.
---

<section class="home-card spotify-card" aria-labelledby="spotify-title">
  <div class="home-card__header">
    <span class="spotify-card__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false">
        <circle cx="12" cy="12" r="10" />
        <path d="M7.4 9.2c3.4-1 7.2-.7 10.1 1" />
        <path d="M8.1 12.2c2.8-.8 5.8-.5 8.1.8" />
        <path d="M8.8 15c2-.5 4.2-.3 5.9.6" />
      </svg>
    </span>
    <h2 id="spotify-title">My Spotify Top Songs</h2>
  </div>
  <ol class="spotify-card__list">
    {
      placeholderSongs.map((song) => (
        <li class="spotify-card__row">
          <span class="spotify-card__track">{song.title}</span>
          <span class="spotify-card__artist">{song.artist}</span>
        </li>
      ))
    }
  </ol>
</section>
