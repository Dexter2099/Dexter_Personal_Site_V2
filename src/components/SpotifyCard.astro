---
import { getSpotifyTopTracks } from "../lib/spotify";

const topTracks = await getSpotifyTopTracks(3);
---

<section class="home-card spotify-card" aria-labelledby="spotify-title">
  <div class="home-card__header">
    <span class="spotify-card__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false">
        <circle cx="12" cy="12" r="10" />
        <path d="M7.4 9.2c3.4-1 7.2-.7 10.1 1" />
        <path d="M8.1 12.2c2.8-.8 5.8-.5 8.1.8" />
        <path d="M8.8 15c2-.5 4.2-.3 5.9.6" />
      </svg>
    </span>
    <h2 id="spotify-title">On rotation</h2>
  </div>
  <ol class="spotify-card__list">
    {
      topTracks.map((track) => (
        <li class="spotify-card__row">
          <span class="spotify-card__art" aria-hidden="true">
            {
              track.albumImageUrl ? (
                <img src={track.albumImageUrl} alt="" loading="lazy" decoding="async" />
              ) : (
                <span>♪</span>
              )
            }
          </span>
          <span class="spotify-card__details">
            {
              track.url ? (
                <a class="spotify-card__track" href={track.url} target="_blank" rel="noreferrer">
                  {track.title}
                </a>
              ) : (
                <span class="spotify-card__track">{track.title}</span>
              )
            }
            <span class="spotify-card__artist">{track.artists}</span>
          </span>
        </li>
      ))
    }
  </ol>
</section>
