---
export interface Props {
  href?: string;
  label: string;
  ariaLabel?: string;
  target?: string;
  rel?: string;
  variant?: "primary" | "secondary";
}

const { href, label, ariaLabel, target, rel, variant = "primary" } = Astro.props;
const className = `button button--${variant}`;
---

{
  href ? (
    <a class={className} href={href} aria-label={ariaLabel} target={target} rel={rel}>
      {label}
    </a>
  ) : (
    <button class={className} type="button" aria-label={ariaLabel}>
      {label}
    </button>
  )
}
