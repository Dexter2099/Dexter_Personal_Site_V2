---
import Footer from "../components/Footer.astro";
import SideRaysBackground from "../components/SideRaysBackground.astro";
import SideNav from "../components/SideNav.astro";
import PortfolioChat from "../components/PortfolioChat.astro";
import { siteCopy } from "../data/site-copy";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dexter Mehta",
  description = "Backend developer portfolio focused on APIs, databases, and practical AI applications."
} = Astro.props;
const siteOrigin = "https://dexter-developer.dev";
const pageUrl = new URL(Astro.url.pathname, siteOrigin).href;
const previewImage = new URL(siteCopy.socialPreview.image, siteOrigin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteCopy.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={siteCopy.socialPreview.width} />
    <meta property="og:image:height" content={siteCopy.socialPreview.height} />
    <meta property="og:image:alt" content={siteCopy.socialPreview.alt} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="twitter:image:alt" content={siteCopy.socialPreview.alt} />
    <meta name="theme-color" content="#07080A" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400&family=Gloock&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SideRaysBackground />
    <div class="site-shell">
      <main id="main-content" class="site-main">
        <slot />
      </main>
      <Footer />
      <SideNav />
    </div>
    {(import.meta.env.DEV || import.meta.env.PUBLIC_PORTFOLIO_CHAT === 'true') && <PortfolioChat />}
  </body>
</html>
