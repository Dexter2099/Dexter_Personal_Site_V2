---
import HomeSocialLinks from "../components/react/HomeSocialLinks.jsx";
import HomeSupportingContent from "../components/react/HomeSupportingContent.jsx";
import HeroTitleEffect from "../components/react/HeroTitleEffect.jsx";
import { socialLinks } from "../data/links";
import { techStack } from "../data/tech";
import { getSpotifyTopTracks } from "../lib/spotify";
import BaseLayout from "../layouts/BaseLayout.astro";

const topTracks = await getSpotifyTopTracks(3);
---

<BaseLayout title="Dexter Mehta">
  <div class="home-page">
    <section class="hero home-hero" aria-labelledby="home-title">
      <div class="hero__panel home-hero__content">
        <HeroTitleEffect client:only="react" />
        <HomeSocialLinks
          client:only="react"
          socialLinks={socialLinks}
        />
      </div>
    </section>
    <HomeSupportingContent
      client:only="react"
      techStack={techStack}
      initialTracks={topTracks}
    />
  </div>
</BaseLayout>
