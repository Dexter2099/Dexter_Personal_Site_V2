---
import ImageFeature from "../components/ImageFeature.astro";
import { authorLinks } from "../data/author";
import BaseLayout from "../layouts/BaseLayout.astro";

const goodreadsLink = authorLinks.find((link) => link.label === "Goodreads")!;
---

<BaseLayout title="About | Dexter Mehta">
  <div class="about-page">
    <div class="about-page__section about-page__section--about">
      <ImageFeature
        title="About Me"
        imageSrc="/images/profile.jpg"
        imageAlt="Dexter Mehta profile photo"
        imageWidth={3024}
        imageHeight={4032}
        loading="eager"
        imageVariant="portrait"
      >
        <div class="prose">
          <p>
            I’m a software developer based in Brisbane with a Master of Information Technology from Queensland University of Technology, majoring in Computer Science. I’m focused on fullstack development and practical AI applications.
          </p>
          <p>
            I moved into tech when I saw AI becoming one of the most transformative technologies of our time. That pulled me toward software engineering, because real AI products still depend on strong foundations.
          </p>
          <p>
            Outside of programming, I enjoy powerlifting and movies. I also enjoy writing,
            <a class="about-book-link" href={goodreadsLink.href} target="_blank" rel="noreferrer"><em>I Am Your Beast</em></a>.
          </p>
          <p>
            My goal is to build a long-term career in software engineering, keep improving as a developer, and create a stable future where I can support my family through meaningful work.
          </p>
        </div>
      </ImageFeature>
    </div>

  </div>
</BaseLayout>

<style>
  .about-book-link {
    color: var(--gold-soft);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .about-book-link:hover {
    color: var(--text-primary);
  }
</style>
