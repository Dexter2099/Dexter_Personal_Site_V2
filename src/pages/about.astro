---
import ImageFeature from "../components/ImageFeature.astro";
import { authorLinks } from "../data/author";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteCopy } from "../data/site-copy";

const goodreadsLink = authorLinks.find((link) => link.label === "Goodreads")!;
---

<BaseLayout title="About | Dexter Mehta">
  <div class="about-page">
    <div class="about-page__section about-page__section--about">
      <ImageFeature
        title="About Me"
        imageSrc="/images/profile.jpg"
        imageAlt="Dexter Mehta profile photo"
        imageWidth={3024}
        imageHeight={4032}
        loading="eager"
        imageVariant="portrait"
      >
        <div class="prose">
          <p>
            {siteCopy.about.introduction}
          </p>
          <p>
            {siteCopy.about.motivation}
          </p>
          <p>
            {siteCopy.about.interests}{" "}
            <a class="about-book-link" href={goodreadsLink.href} target="_blank" rel="noreferrer"><em>{siteCopy.about.book}</em></a>.
          </p>
          <p>
            {siteCopy.about.goal}
          </p>
        </div>
      </ImageFeature>
    </div>

  </div>
</BaseLayout>

<style>
  .about-book-link {
    color: var(--gold-soft);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .about-book-link:hover {
    color: var(--text-primary);
  }
</style>
