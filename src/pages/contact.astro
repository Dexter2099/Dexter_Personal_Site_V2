---
import Button from "../components/Button.astro";
import BorderGlow from "../components/react/BorderGlow.jsx";
import { socialLinks } from "../data/links";
import BaseLayout from "../layouts/BaseLayout.astro";

const emailLink = socialLinks.find((link) => link.label === "Email");

if (!emailLink) {
  throw new Error("Email link is missing from src/data/links.ts");
}
---

<BaseLayout title="Get in Touch | Dexter Mehta">
  <section class="contact-page" aria-labelledby="contact-title">
    <BorderGlow
      client:load
      className="contact-panel"
      edgeSensitivity={70}
      glowColor="46 65 52"
      backgroundColor="#0D1016"
      borderRadius={8}
      glowRadius={18}
      glowIntensity={0.38}
      coneSpread={8}
      animated={false}
      colors={["#E8D68A", "#D4AF37", "#8A6A12"]}
      fillOpacity={0}
    >
      <h1 class="contact-title" id="contact-title">Get in Touch</h1>
      <p>
        I'm currently available for freelance projects and consulting opportunities. Feel free to reach out if you'd like to work together.
      </p>
      <div class="contact-panel__action">
        <Button
          href={emailLink.href}
          label="Email"
          variant="primary"
          ariaLabel="Email Dexter Mehta"
          icon="mail"
        />
      </div>
    </BorderGlow>
  </section>
</BaseLayout>
