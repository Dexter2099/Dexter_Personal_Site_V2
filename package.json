{
  "name": "dexter-personal-site-v2",
  "version": "1.2.13",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run chat:check",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "chat:build": "node scripts/chat-local.mjs build",
    "chat:local": "node scripts/chat-local.mjs",
    "chat:openai": "node scripts/chat-local.mjs --openai",
    "chat:migrate": "node scripts/chat-local.mjs migrate",
    "chat:check": "tsc -p tsconfig.chat.json && node scripts/chat-knowledge.mjs",
    "chat:test": "tsx --test tests/chat/*.test.ts",
    "chat:report": "node scripts/chat-report.mjs",
    "chat:refresh": "node scripts/chat-knowledge.mjs --refresh",
    "chat:github": "node scripts/chat-github.mjs",
    "chat:sync": "node scripts/chat-public-sync.mjs",
    "chat:eval": "node scripts/chat-eval.mjs",
    "chat:cleanup": "node scripts/chat-cleanup.mjs",
    "chat:clear-local-secrets": "node scripts/chat-clear-local-secrets.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "astro": "^7.3.8",
    "dotenv": "^17.4.2",
    "motion": "^12.42.2",
    "ogl": "^1.0.11",
    "react": "^19.2.7",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.7",
    "simple-icons": "^16.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "miniflare": "^5.20261006.1-alpha",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "wrangler": "^4.149.0"
  }
}
